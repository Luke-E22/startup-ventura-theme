# Environment variables for startupventura.com (set in Netlify: Site configuration >
# Environment variables). Nothing here is committed with a real value.

# --- Cloudflare Turnstile (bot check on every form) ---
# Managed mode widget for startupventura.com and www.startupventura.com, a separate
# widget from the VCIF site's. The site key is baked into the pages at build time; the
# secret is used only by netlify/functions/submit.mjs. Leave BOTH empty to skip the
# widget and the check in local preview; the build and the function each log one
# warning. The pair below is Cloudflare's published always-pass test pair:
# DEVELOPMENT ONLY, never in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Notion CRM sync (netlify/functions/submission-created.mjs) ---
NOTION_TOKEN=

# --- Klaviyo newsletter subscribe (optional; skipped when empty) ---
KLAVIYO_PRIVATE_KEY=
KLAVIYO_LIST_ID=
